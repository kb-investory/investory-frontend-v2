# ==========================================
# Investory Frontend 환경 변수 설정 예시
# (.env 파일로 복사하여 사용하세요: cp .env.example .env)
# ==========================================

# 1) 브라우저에서 사용할 API prefix
# 배포 프록시가 /api 아래에 백엔드를 노출하므로 /api를 사용합니다.
VITE_API_BASE_URL=/api

# 2) Vite 개발 서버가 전달할 자바 코어 백엔드 주소
# 실제 개발·운영 주소는 Git에 포함되지 않는 .env.local에서 설정합니다.
VITE_API_TARGET_URL=http://localhost:8080/api/v1

# 3) 파이썬 AI 시뮬레이션 서버 주소 (로컬 8000 포트)
VITE_AI_TARGET_URL=http://localhost:8000

# 4) 로컬 개발용 테스트 로그인 사용 여부
# 개발 모드에서만 동작하며, 운영 빌드에서는 항상 실제 인증 API를 사용합니다.
VITE_USE_TEST_AUTH=false

# 5) 로컬 투자일지 UI 테스트용 목 데이터 사용 여부
# 개발 모드에서만 동작하며, 운영 빌드에서는 항상 실제 API를 사용합니다.
VITE_USE_MOCK_JOURNAL=false

# 6) 로컬 투자성향·투자원칙 UI 테스트용 목 데이터 사용 여부
# 개발 모드에서만 동작하며, 운영 빌드에서는 항상 실제 API를 사용합니다.
VITE_USE_MOCK_TENDENCY=false

# 7) 로컬 시뮬레이션 UI 테스트용 목 데이터 사용 여부
# 개발 모드에서만 동작하며, 운영 빌드에서는 항상 실제 API를 사용합니다.
VITE_USE_MOCK_SIMULATION=false
