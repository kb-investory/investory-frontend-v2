# ==========================================
# Investory Frontend 환경 변수 설정 예시
# (.env 파일로 복사하여 사용하세요: cp .env.example .env)
# ==========================================

# 1) 자바 코어 백엔드 서버 주소 (배포 서버 주소)
# 예: http://investory.duckdns.org/api/v1
VITE_API_TARGET_URL=http://investory.duckdns.org/api/v1

# 2) 파이썬 AI 시뮬레이션 서버 주소 (로컬 8000 포트)
VITE_AI_TARGET_URL=http://localhost:8000

# API 통신 실패 시 목데이터 Fallback 사용 여부 (true: 목데이터 사용, false: 끄기)
VITE_USE_MOCK_FALLBACK=true
