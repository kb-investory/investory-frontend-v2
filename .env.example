# ==========================================
# Investory Frontend 환경 변수 설정 예시
# (.env 파일로 복사하여 사용하세요: cp .env.example .env)
# ==========================================

# 1) 브라우저에서 사용할 API 기준 주소
# 개발 proxy 또는 동일 origin을 사용하면 비워둡니다.
VITE_API_BASE_URL=

# 2) Vite 개발 서버가 전달할 자바 코어 백엔드 주소
# 실제 개발·운영 주소는 Git에 포함되지 않는 .env.local에서 설정합니다.
VITE_API_TARGET_URL=http://localhost:8080/api/v1

# 3) 파이썬 AI 시뮬레이션 서버 주소 (로컬 8000 포트)
VITE_AI_TARGET_URL=http://localhost:8000
